{
  "manifest_version": 3,
  "name": "Sitefinity Preview Helper",
  "version": "1.0.0",
  "description": "Fixes Sitefinity /Action/Preview URLs (multisite aware) and jumps between authoring and Production.",
  "permissions": ["storage", "contextMenus", "scripting", "activeTab", "tabs"],
  "host_permissions": [
    "https://scottsdaleaz-aut.sitefinity.cloud/*",
    "https://www.scottsdaleaz.gov/*",
    "https://scottsdaleaz.gov/*",
    "https://www.scottsdalelibrary.org/*",
    "https://scottsdalelibrary.org/*",
    "https://www.choosescottsdale.com/*",
    "https://choosescottsdale.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://scottsdaleaz-aut.sitefinity.cloud/*"],
      "js": ["sites.js", "content.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_title": "Sitefinity Preview Helper",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "options.html",
  "commands": {
    "open-production": {
      "suggested_key": { "default": "Alt+Shift+P" },
      "description": "View this page in Production"
    },
    "open-authoring": {
      "suggested_key": { "default": "Alt+Shift+A" },
      "description": "Open the authoring page (from Preview, or from Production when logged in)"
    }
  }
}
